{
  "info": {
    "name": "Order System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "a3f2a7b0-6a9e-4e9b-8a0e-order-system-collection"
  },
  "variable": [
    { "key": "productBaseUrl", "value": "http://localhost:5001" },
    { "key": "orderBaseUrl", "value": "http://localhost:5002" },
    { "key": "pricingBaseUrl", "value": "http://localhost:5003" },
    { "key": "productId", "value": "1" },
    { "key": "orderId", "value": "1" }
  ],
  "item": [
    {
      "name": "Product Service",
      "item": [
        {
          "name": "Get all products",
          "request": {
            "method": "GET",
            "url": "{{productBaseUrl}}/api/products"
          }
        },
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "url": "{{productBaseUrl}}/api/products/{{productId}}"
          }
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop\",\n  \"price\": 1200,\n  \"stockQuantity\": 10\n}"
            },
            "url": "{{productBaseUrl}}/api/products"
          }
        },
        {
          "name": "Create product - invalid (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"price\": 0,\n  \"stockQuantity\": -1\n}"
            },
            "url": "{{productBaseUrl}}/api/products"
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Pro\",\n  \"price\": 1500,\n  \"stockQuantity\": 12\n}"
            },
            "url": "{{productBaseUrl}}/api/products/{{productId}}"
          }
        },
        {
          "name": "Delete product",
          "request": {
            "method": "DELETE",
            "url": "{{productBaseUrl}}/api/products/{{productId}}"
          }
        },
        {
          "name": "Reduce stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}"
            },
            "url": "{{productBaseUrl}}/api/products/{{productId}}/reduce-stock"
          }
        },
        {
          "name": "Reduce stock - insufficient (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 999999\n}"
            },
            "url": "{{productBaseUrl}}/api/products/{{productId}}/reduce-stock"
          }
        }
      ]
    },
    {
      "name": "Order Service",
      "item": [
        {
          "name": "Place order (async — returns Status: Submitted)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Ali\",\n  \"productId\": {{productId}},\n  \"quantity\": 2\n}"
            },
            "url": "{{orderBaseUrl}}/api/orders",
            "description": "Returns 201 immediately with status 0 (Submitted). Re-run 'Get order by id' a couple of seconds later — the Order Worker processes it asynchronously and flips it to 1 (Approved) or 2 (Rejected)."
          }
        },
        {
          "name": "Place order - with Idempotency-Key (retry-safe)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "demo-key-1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Ali\",\n  \"productId\": {{productId}},\n  \"quantity\": 2\n}"
            },
            "url": "{{orderBaseUrl}}/api/orders",
            "description": "Send this request twice in a row with the same Idempotency-Key header. The second call returns the SAME order id instead of creating a duplicate."
          }
        },
        {
          "name": "Place order - will be rejected for insufficient stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Ali\",\n  \"productId\": {{productId}},\n  \"quantity\": 999999\n}"
            },
            "url": "{{orderBaseUrl}}/api/orders",
            "description": "Still returns 201/Submitted immediately — check the order a few seconds later and it will show status 2 (Rejected) with a rejectionReason, because the worker's stock check failed."
          }
        },
        {
          "name": "Place order - invalid (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"\",\n  \"productId\": {{productId}},\n  \"quantity\": 0\n}"
            },
            "url": "{{orderBaseUrl}}/api/orders"
          }
        },
        {
          "name": "Get all orders",
          "request": {
            "method": "GET",
            "url": "{{orderBaseUrl}}/api/orders"
          }
        },
        {
          "name": "Get order by id (poll this after placing an order)",
          "request": {
            "method": "GET",
            "url": "{{orderBaseUrl}}/api/orders/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "Pricing Service (simulated)",
      "item": [
        {
          "name": "Get a quote",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"basePrice\": 50,\n  \"quantity\": 2\n}"
            },
            "url": "{{pricingBaseUrl}}/api/pricing/quote",
            "description": "Called by the Order Worker, not the browser. ~1 in 6 calls returns 503 on purpose, to exercise the worker's retry/circuit-breaker handling."
          }
        }
      ]
    }
  ]
}
